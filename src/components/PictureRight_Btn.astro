---
import Button from "./Button.astro";
import TextBody from "./TextBody.astro";
import TextHeading from "./TextHeading.astro";
const { image, alt, heading, textbody1, textbody2, href, button, stylingclasses } = Astro.props;
---

<section class={`${stylingclasses}`}>
    <div class="bg-primary-500">
        <div class="grid xl:grid-cols-2 place-items-center gap-8 px-space-500 py-space-1000 lg:px-space-2400 lg:py-space-1600">        
            
            <div>
                <TextHeading size="l" stylingclasses="pb-space-025">{heading}</TextHeading>
                <TextBody size="l-regular" stylingclasses="pb-space-100">{textbody1}</TextBody>
                <TextBody size="l-regular" stylingclasses="pb-space-200">{textbody2}</TextBody>
                <Button href={href}>{button}</Button>
            </div>
            
            <div class="xl:pl-space-500">
                <img src={image} alt={alt} class="w-100 h-auto md:w-150 md:h-auto object-cover"/>
            </div>
        </div>
    </div>
</section>