---
import Button from "./Button.astro";
import TextHeading from "./TextHeading.astro";
import TextBody from "./TextBody.astro";
const {heading, textbody1, textbody2, felt, besked, mx, knap} = Astro.props;
---
<div class={`pb-space-1000 lg:pb-space-1800 ${mx}`}>

    <form name="bestil" action="https://api.web3forms.com/submit" method="POST">
        <TextHeading size="m-green" stylingclasses="pb-space-050">{heading}</TextHeading>
        <TextBody size="l-regular" stylingclasses="pb-space-050">{textbody1}</TextBody>
        <TextBody size="l-regular" stylingclasses="pb-space-300">{textbody2}</TextBody>

        <input type="hidden" name="access_key" value="4c6a056b-13e6-4ac8-9054-ce047f239748">
        <!-- Fuld navn felt -->
        <div class="grid mb-6">
            <label for="full-name" class="pb-space-050"><TextBody size="l-regular">Dit fulde navn *</TextBody></label>
                <input
                    class="border-1 border-accent-600 p-space-050 placeholder:text-grey-scale-400"
                    placeholder="Peter Jensen"
                    id="full-name"
                    name="fname"
                    type="text"
                    required
                />
        </div>

        <!-- Email felt -->
        <div class="grid mb-6">
            <label for="email" class="pb-space-050"><TextBody size="l-regular">E-mail *</TextBody></label>
                <input
                    class="border-1 border-accent-600 p-space-050 placeholder:text-grey-scale-400"
                    placeholder="peter@mail.dk"
                    id="email"
                    name="email"
                    type="email"
                    required
                />
        </div>

        <!-- Telefonnummer felt -->
        <div class="grid mb-6">
            <label for="telephone" class="pb-space-050"><TextBody size="l-regular">Telefonnummer *</TextBody></label>
                <input
                    class="border-1 border-accent-600 p-space-050 placeholder:text-grey-scale-400"
                    id="telephone"
                    name="telephone"
                    type="tel"
                    placeholder="12 34 56 78"
                    required
            />
        </div>

        <!-- Besked felt -->
        <div class="grid mb-6">
            <label for="bestilling" class="pb-space-050"><TextBody size="l-regular">{felt} *</TextBody></label>
                <textarea
                    id="bestilling"
                    name="bestilling"
                    placeholder={besked}
                    class="border-1 border-accent-600 p-space-050 resize-none h-32 placeholder:text-grey-scale-400"
                    required
                ></textarea>
        </div>

        <div class="mb-6">
            <div class="flex flex-col gap-2 mt-2">
                <label class="flex items-center gap-2">
                <input type="checkbox" checked="checked" class="checkbox border-accent-600 after:text-grey-scale-950" required/><TextBody size="l-regular">Jeg stoler på at i behandler mine data indefor GDPR Logivning</TextBody></label>
            </div>
        </div>

        <!-- Bekræft knap -->
        <button type="submit" class="group relative flex justify-center items-center font-raleway text-body-m md:text-body-l text-primary-200 uppercase fill-accent-600 hover:cursor-pointer hover:text-accent-700 hover:fill-accent-300 w-[140px] h-[40px] md:w-[180px] md:h-[50px]">
                <svg viewBox="0 0 1118 298" class="absolute w-full h-full transition-all duration-150 group-active:[filter:var(--shadow-drop-50)] group-active:scale-[0.98]">
                <path d="M1110.65 98.6012C1104.74 87.5321 1085.03 60.168 1071.95 49.3545C1036.01 19.6403 1005.36 19.541 955.277 14.585C941.096 13.1792 882.459 11.5462 870.269 9.74273C817.527 1.93966 629.051 5.91575 552.787 1.08054C493.404 -2.68964 355.194 4.41051 319.618 7.03757C210.093 15.1318 102.794 1.50655 56.4831 21.813C-42.7305 65.3157 20.5343 89.939 13.0834 133.527C12.9465 134.343 11.7275 135.224 11.7524 136.438C10.8443 138.568 4.68702 174.09 7.58531 175.297C17.5241 179.458 26.8285 252.98 39.2177 259.015C77.2936 277.582 98.2657 286.251 177.254 286.919C211.299 287.21 288.545 278.441 377.124 281.991C399.016 282.872 748.826 292.741 784.601 292.741C840.987 292.734 1004.05 310.015 1053.93 281.963C1057.03 280.344 1074.29 268.196 1078.81 262.373C1105.07 228.534 1079.9 237.48 1101.11 191.365C1104.87 183.192 1130.27 135.43 1110.63 98.5941L1110.65 98.6012Z"/></svg>
                <span class="relative z-10">{knap}</span></button>
    </form>
</div>
