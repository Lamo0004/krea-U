---
const { href = "#", target = "_self" } = Astro.props;

// Funktion til at fjerne trailing slash
const normalize = (url) => url.replace(/\/$/, "");
const currentUrl = normalize(Astro.url.pathname);
const normalizedHref = normalize(href);

const isActive = normalizedHref === currentUrl;

const linkClasses = `
font-raleway text-body-m text-grey-scale-950
  ${isActive ? "font-bold" : ""}
  hover:font-bold
`;

// Brug group/item så den IKKE reagerer på parent .group
const underlineWrapper = isActive
  ? "w-22 overflow-hidden [clip-path:inset(0_0_0_0)]"
  : "w-22 overflow-hidden [clip-path:inset(0_100%_0_0)] group-hover/item:[clip-path:inset(0_0_0_0)] transition-[clip-path] duration-300";
---

<div class="flex flex-col group/item py-space-250 px-space-3200">
  <a href={href} target={target} class={linkClasses}>
    <slot />
  </a>

  <div class={underlineWrapper}>
    <img src="../underline.svg" alt="" />
  </div>
</div>
