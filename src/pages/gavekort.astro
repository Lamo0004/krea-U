---
import MainLayout from "../layouts/MainLayout.astro";
import HeroNiveau2 from "../components/HeroNiveau2.astro";
import Formular from "../components/Formular.astro"
---
<MainLayout title="Gavekort">
    <HeroNiveau2
        image="../gavekorthero.webp" 
        alt="sættekasse med krus i hullerne" 
        display="Gavekort"
        textbody="Giv en kreativ oplevelse i gave og glæd en, du holder af, med et gavekort til KREA-U, hvor der er plads til ro, hygge og kreativ udfoldelse."
        stylingclasses="mb-spacing-1000 lg:mb-spacing-1800"/>

   <Formular
        mx="lg:mx-spacing-3000"
        heading="Giv en kreativ oplevelse"
        textbody1="Køb dit gavekort her og få det tilsendt på mail. Vi sender gavekortet, når betalingen er modtaget via. Mobilepay."
        textbody2="Du kan selvfølgelig også købe gavekort i vores cafe."
        felt="Gavekort"
        besked="Skriv beløb på dit gavekort her"
        knap="Bestil nu"/>

    <img src="../event_blur.svg" alt="tegning af et forklæde" class="absolute top-290 right-35 w-70 h-auto"/>

</MainLayout>