---
import MainLayout from "../layouts/MainLayout.astro";
import HeroNiveau2 from "../components/HeroNiveau2.astro";
import Formular from "../components/Formular.astro"
---
<MainLayout title="Gavekort" description="Giv en kreativ oplevelse i gave og glæd en, du holder af, med et gavekort til KREA-U.">
    <HeroNiveau2
        image="../gavekorthero.webp" 
        alt="en skål der er ved at blive malet" 
        display="Gavekort"
        textbody="Giv en kreativ oplevelse i gave og glæd en, du holder af, med et gavekort til KREA-U."
        stylingclasses="mb-spacing-1000 lg:mb-spacing-1800"/>

   <Formular
        mx="lg:mx-spacing-3000"
        heading="Giv en kreativ oplevelse"
        textbody1="Køb dit gavekort her og få det tilsendt på mail. Vi sender gavekortet, når betalingen er modtaget via. Mobilepay."
        textbody2="Du kan selvfølgelig også købe gavekort i vores værksted."
        felt="Gavekort"
        besked="Skriv beløb på dit gavekort her"
        knap="Bestil nu"/>

    <img src="../gavekort_blur.svg" alt="tegning af et forklæde" class="absolute top-290 right-40 w-80 h-auto rotate-15"/>

</MainLayout>