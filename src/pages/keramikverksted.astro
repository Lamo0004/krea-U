---
import MainLayout from "../layouts/MainLayout.astro";
import TextBody from "../components/TextBody.astro";
import TextDisplay from "../components/TextDisplay.astro";
import PictureLeftBtn from "../components/PictureLeft_Btn.astro";
import Pris_Overblik from "../components/Pris_Overblik.astro";
import FullBleedSection from "../components/FullBleedSection.astro";
---
<MainLayout title="Keramikværksted">
	<section class="pb-space-1000 lg:pb-space-1800">
		<div class="relative">
			<div class="flex flex-col items-center justify-center text-center pt-space-800 px-space-200 md:px-space-1400 lg:px-space-2000">
				<TextDisplay color="black">Keramikværksted</TextDisplay>
				<TextBody size="l-regular">I vores keramikværksted kan du male lige det, du har lyst til.<br>Vælg et hav af keramik, og skab dit eget personlige udtryk. Vi glæder os til at se dig.</TextBody>
			</div>
            <img src="../kande_blur.svg" alt="tegning af en kande" class="absolute top-20 right-0 w-60 h-auto"/>
		</div>
	</section>

	<FullBleedSection>
		<PictureLeftBtn
			image="../keramikværksted.webp"
			alt="piger der snakker med en dame"
			heading="Mal dit keramik"
			textbody1="Kom ned i vores værksted og mal lige det keramik, du ønsker. Vi har et hav af keramik at vælge imellem – kopper, skåle, figurer, fade, vaser og meget mere. Vi hjælper dig gerne med idéer, farver og teknikker, så du trygt kan fordybe dig og nyde kreativiteten."
			textbody2= "Du betaler kun for det keramik, du vælger at male. Vi sørger for glasering og brænding, så du kan hente dit færdige keramik ca. 14 dage efter. Priserne varierer afhængigt af størrelse og type. Du kan få et overblik over vores priser her."/>
    </FullBleedSection>

	<Pris_Overblik></Pris_Overblik>

	<figure class="diff aspect-3/4 md:aspect-16/9 md:px-space-400 pb-space-1000 lg:pb-space-1800" tabindex="0">
		<div class="diff-item-1" role="img" tabindex="0">
			<img alt="daisy" src="../keramikfør.webp"/>
		</div>
		<div class="diff-item-2" role="img">
			<img alt="daisy" src="../keramikefter.webp"/>
		</div>
		<input type="range" class="diff-resizer"></input>
	</figure>

</MainLayout>