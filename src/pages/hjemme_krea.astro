---
import MainLayout from "../layouts/MainLayout.astro";
import HeroNiveau2 from "../components/HeroNiveau2.astro";
import PictureRight_Btn from "../components/PictureRight_Btn.astro";
import StepByStep from "../components/StepByStep.astro";
import TextHeading from "../components/TextHeading.astro";
import TextBody from "../components/TextBody.astro";
import Formular from "../components/Formular.astro"
import FullBleedSection from "../components/FullBleedSection.astro";
---
<MainLayout title="Hjemme-krea" description="Skab ro og hygge med en Hjemme-Krea kasse. Alt, du behøver for at male keramik derhjemme.">
    <HeroNiveau2
        image="../hjemmekrea_hero.webp" 
        alt="sættekasse med krus i hullerne" 
        display="Hjemme-krea" 
        textbody="Tag KREA-U med hjem. Skab ro og hygge med en Hjemme-Krea kasse. Alt, du behøver for at male keramik derhjemme."/>

    <FullBleedSection>
    <PictureRight_Btn
        heading="Tag med hjem"
		textbody1="Med vores Hjemme-krea kan du tage KREA-U’s kreative værksted med hjem. Uanset om du ønsker kreativitet alene eller en hyggelig stund med familie/venner, har vi gjort det nemt for dig. "
		textbody2= "Vælg mellem 3 forskellige kasser, som hver indeholder keramik, maling, pensler og alt det, du skal bruge for at komme i gang. Du kan se kasserne længere nede på siden samt følge vores guide, så du ved præcis, hvad du skal gøre fra start til slut."
        image="../hjemme-krea.webp"
		alt="pige der maler"
        href="#formular"
		button="Bestil nu"
        stylingclasses="pb-space-1000 lg:pb-space-1800"/>
    </FullBleedSection>

	<StepByStep
        heading1="Sådan gør du"
    	image1="../step1.svg"
        image1Alt="Tegning af ikke dekoreret vase"
		first_step="Vælg"
		textbody1="Se beskrivelserne af vores tre Hjemme-Krea kasser og bestil den, du ønsker. Du får alt du skal det bruge med hjem."
		image2="../step2.svg"
        image2Alt="Tegning af en kop der bliver malet på"
        second_step="Mal"
		textbody2="Lad kreativiteten begynde derhjemme, og mal på din keramik. Du kan finde masser af inspiration på vores sociale medier."
		image3="../step3.svg"
        image3Alt="Tegning af en hånd som aflevere en kop"
		third_step="Aflever"
		textbody3="Når malingen er tør, pakker du keramikken forsigtigt ind og afleverer det hos os. Husk at skrive initialer og dato i bunden."
		image4="../step4.svg"
        image4Alt="Tegning af to stablede kopper"
		fourth_step="Afhent"
		textbody4="Vi glaserer og brænder dit keramik. Når det er klar, får du besked, og du kan hente det hos os efter ca. 14 dage."/>

        
    <TextHeading size="l" stylingclasses="pb-space-500 fadein">Vores hjemme-krea kasser</TextHeading>
    <section class="grid md:grid-cols-2 xl:grid-cols-3 gap-20 md:gap-30 xl:gap-50 max-w-[1200px] pb-space-1000 lg:pb-space-1800 fadein">
        <div>
            <img class="pb-space-200 object-cover" src="../kasse1.webp" alt="hjemmekasse 1 med kopper"/>
            <TextHeading size="m" stylingclasses="pb-space-050">Kasse 1</TextHeading>
            <TextBody size="l-regular" stylingclasses="pb-space-050">Mal to personlige kopper til dig og en du holder af. Alt, du skal bruge, følger med.</TextBody>
        </div>

        <div>
            <img class="pb-space-200 object-cover" src="../kasse2.webp" alt="hjemmekasse 2 med tallerkener"/>
            <TextHeading size="m" stylingclasses="pb-space-050">Kasse 2</TextHeading>
            <TextBody size="l-regular" stylingclasses="pb-space-050">Mal dine egne unikke tallerkner til bordets hyggelige øjeblikke. Alt, du skal bruge, følger med.</TextBody>
        </div>

        <div>
            <img class="pb-space-200 object-cover" src="../kasse3.webp" alt="hjemmekasse 3 med skåle"/>
            <TextHeading size="m" stylingclasses="pb-space-050">Kasse 3</TextHeading>
            <TextBody size="l-regular" stylingclasses="pb-space-050">Tag en du holder af under armen og mal sammen en smuk skål. Alt, du skal bruge, følger med. .</TextBody>
        </div>
    </section>

    <div id="formular" class="fadein">
        <Formular
                mx="lg:mx-spacing-3000"
                heading="Bestil her"
                textbody1="Udfyld formularen med hvilken kasse du ønsker, og hvor mange du vil bestille. Vi pakker det klar til dig og giver besked, når din kasse er klar til afhentning."
                textbody2="Du er selvfølgelig også altid velkommen til at købe dine Hjemme-Krea kasser hos os i værkstedet."
                felt="Din bestilling"
                besked="Skriv dit ønske til Hjemme-Krea-kasse her"
                knap="Bestil nu"/>
    </div>

</MainLayout>