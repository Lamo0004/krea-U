---
import MainLayout from "../layouts/MainLayout.astro";
import HeroNiveau2 from "../components/HeroNiveau2.astro";
import StepByStep from "../components/StepByStep.astro";
import FullBleedSection from "../components/FullBleedSection.astro";
import PictureRightBtn from "../components/PictureRight_Btn.astro";
---
<MainLayout title="Koncept" class="relative">
    <HeroNiveau2
        image="../koncept_hero.webp" 
        alt="pige der kigger på maling" 
        display="Vores koncept" 
        textbody="Hos KREA-U har vi en vision om at skabe et kreativt frirum, hvor alle kan finde ro og fordybelse. Et sted, hvor hverdagen kan lægges fra sig, og hvor kreativiteten får plads."
        stylingclasses="mb-spacing-1000 lg:mb-spacing-1800"/>

	<StepByStep
		heading1="Sådan gør du"
		image1="../step1_1.svg"
		first_step="Book"
		textbody1="Book et bord og vælg, om du vil sidde i keramikværkstedet eller smykkeværkstedet."
		image2="../step2_1.svg"
		second_step="Vælg"
		textbody2="Få en introduktion af en medarbejder og gå på opdagelse i keramik, perler, maling, pensler og redskaber. Vi hjælper gerne med idéer og tips."
		image3="../step3_1.svg"
		third_step="Krea"
		textbody3="Sæt dig til rette, bestil noget fra caféen og fordyb dig i dit projekt. Vi står klar til at guide dig undervejs."
		image4="../step4_1.svg"
		fourth_step="Afhent"
		textbody4="Smykker tager du med hjem med det samme. Keramik glaserer og brænder vi. Du kan hente det ca. 14 dage efter."/>

	<FullBleedSection>
		<div class="fadein">
		<PictureRightBtn
			heading="Hjertet bag"
			textbody1="KREA-U er startet af Birgitte Enemark, med en passion for mental sundhed og kreativt nærvær. Hun ønskede at skabe et roligt værksted, hvor man kan lægge hverdagen fra sig, slippe skærmene og finde fordybelse i nuet gennem kreativitet. Bag værkstedet står et varmt og engageret personale, som altid er klar til at hjælpe dig godt i gang."
			textbody2= "I KREA-U er alle velkomne – både nybegyndere og erfarne. Du kan sætte dig og male på keramik, lave dine egne smykker og nyde en kreativ pause. Vi tilbyder samtidig både vores egne events og dit helt eget skræddersyet event, så uanset om det er fødselsdag, firmaarrangement eller en hyggelig stund med venner og familie, skaber vi rammerne for en hyggelig og kreativ oplevelse."
			image="../birgitte.webp"
			alt="Ejeren af Krea-U"
			href="/vores_verksteder"
			button="Se værksteder"/>
		</div>
	</PictureRightBtn>
	
	<img src="../smykke_blur.svg" alt="smykke tegning" class="absolute right-30 top-350 md:top-480 lg:top-280 w-80 md:w-130 h-auto"/>

</MainLayout>