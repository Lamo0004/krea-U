---
import MainLayout from "../layouts/MainLayout.astro";
import HeroNiveau2 from "../components/HeroNiveau2.astro";
import TextHeading from "../components/TextHeading.astro";
import TextBody from "../components/TextBody.astro";
import Formular from "../components/Formular.astro"
import FAQ from "../components/FAQ.astro";
---
<MainLayout title="Praktisk" description="Find vores åbningstider, adresse og kontaktoplysninger her, så du nemt kan planlægge dit besøg.">
    <HeroNiveau2
        image="../praktiskinfo_hero.webp" 
        alt="keramik brænde ovn" 
        display="Praktisk info"
        textbody="Du kan finde vores åbningstider, adresse og kontaktoplysninger her, så du nemt kan planlægge dit besøg."
        stylingclasses="mb-spacing-1000 lg:mb-spacing-1800"/>

    <section id="kontakt_formular" class="relative">
        <div class="grid md:grid-cols-2 gap-15">
            <div>
                <TextHeading size="m-green" stylingclasses="pb-space-300">Det praktiske</TextHeading>
		        <TextBody size="l-regular" stylingclasses="">Vores værksted ligger centralt i Herning. Du er altid velkommen til at kontakte os, hvis du har spørgsmål eller brug for hjælp. Vi glæder os til, at byde dig velkommen!<br><br>Adresse: Søndergade 16, 7400 Herning<br>E-mail: <a href="mailto:info@krea-u.dk">info@krea-u.dk</a><br>Telefon: <a href="tel:+4553821274">53 82 12 74</a><br><br>Mandag: LUKKET<br>Tirsdag - Fredag: 11.30 - 21.00<br>Lørdag - Søndag:  10.00 - 17.00</TextBody>
            </div>

            <Formular
                heading="Har du brug for hjælp?"
                textbody1="Du kan udfylde denne formular, hvis du har spørgsmål eller brug for hjælp. Vi vender tilbage så hurtigt vi kan."
                textbody2="Vi glæder os til at høre fra dig."
                felt="Din besked"
                besked="Skriv din besked til KREA-U her"
                knap="Send besked"/>
        </div>
        <img src="../kande_blur.svg" alt="kande tegning" class="absolute left-0 top-280 w-60 md:top-100 md:w-100 h-auto"/>
    </section>

    <FAQ></FAQ>

</MainLayout>