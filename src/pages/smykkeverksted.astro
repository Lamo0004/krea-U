---
import MainLayout from "../layouts/MainLayout.astro";
import TextBody from "../components/TextBody.astro";
import TextDisplay from "../components/TextDisplay.astro";
import PictureLeftBtn from "../components/PictureLeft_Btn.astro";
import PrisOverblik from "../components/PrisOverblik.astro";
import FullBleedSection from "../components/FullBleedSection.astro";
import TextHeading from "../components/TextHeading.astro";
---
<MainLayout title="Smykkeværksted" description="I vores smykkeværksted kan du designe og lave lige de smykker, du ønsker.">
	<section class="pb-space-1000 lg:pb-space-1800">
		<div class="relative">
			<div class="flex flex-col items-center justify-center text-center pt-space-800 px-space-200 md:px-space-1400 lg:px-space-2000">
				<TextDisplay color="black" stylingclasses="text-grey-scale-950">Smykkeværksted</TextDisplay>
				<TextBody size="l-regular">I vores smykkeværksted kan du designe og lave lige de smykker, du ønsker. <br>Du kan lave præcis det, kreativiteten fører dig til.</TextBody>
			</div>
            
            <img src="../smykke_blur.svg" alt="smykke tegning" class="absolute top-20 right-10 w-120 h-auto"/>
		</div>
	</section>


	<FullBleedSection>
			<PictureLeftBtn
				image="../smykkeverksted.webp"
				alt="smykker på bakke"
				heading="Design smykker"
				textbody1="Kom ned i vores værksted og design dine egne smykker. Vi har et stort udvalg af ta’-selv-perler, kæder, vedhæng og smykkedele, så du kan skabe præcis det udtryk, du ønsker eller lave en personlig gave. Vi hjælper dig gerne med idéer, farver og teknikker, så du trygt kan fordybe dig og nyde kreativiteten. Smykkerne laver du færdige i værkstedet og tager med hjem samme dag."
				textbody2= "Du betaler kun for det smykkedesign og materialer, du vælger. Prisen afhænger altså af de perler og smykkedele, du bruger. Vi glæder os til, at se dig."
				href="https://book.easytable.com/book/?id=35dca"
				target="_blank"
				button="Book bord"/>
	</FullBleedSection>

    <div class="fadein">
		<PrisOverblik></PrisOverblik>
	</div>

	<section>
    	<TextHeading size="l" stylingclasses="pb-space-200 text-center">Træk for at se før og efter</TextHeading>
		<figure class="diff aspect-3/4 md:aspect-16/9 md:px-space-400 pb-space-1000 lg:pb-space-1800 fadein" tabindex="0">
			<div class="diff-item-1" role="img" tabindex="0">
				<img alt="billede af perler" src="../smykke_for.webp"/>
			</div>
			<div class="diff-item-2" role="img">
				<img alt="billede af perlehalskæde" src="../efter.webp"/>
			</div>
			<div class="diff-resizer"></div>
		</figure>
	</section>

</MainLayout>

